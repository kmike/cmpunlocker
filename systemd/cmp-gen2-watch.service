[Unit]
Description=CMP 170HX PCIe Gen2 advertisement-triggered retrain (userspace stage)
After=systemd-udevd.service
ConditionPathExists=/usr/local/sbin/cmp-gen2-watch

[Service]
Type=simple
# Self-bounded: the watcher exits on its own after --duration-ms.
# Catches advertisement windows that open after pivot (module loaded
# from the root fs); the initramfs hooks cover the initramfs-loaded
# shape. Both stages are state-triggered, never timer-blind.
ExecStart=/usr/local/sbin/cmp-gen2-watch --duration-ms 90000
TimeoutStartSec=120
StandardOutput=append:/var/log/cmp-gen2-watch.log
StandardError=append:/var/log/cmp-gen2-watch.log

[Install]
WantedBy=multi-user.target
